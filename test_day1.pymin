// Test logical operators
print("--- Logical Operators ---");
print(true and false); // false
print(true or false);  // true
let condition = !false and true;
print(condition); // true

// Test modulo operator
print("--- Modulo Operator ---");
print(10 % 3); // 1
print(15 % 5); // 0

// Test built-in functions
print("--- Built-in Functions ---");
let start = clock();
print("Current time (clock):");
print(start);

let text = "Hello PyMini";
print("Length of 'Hello PyMini':");
print(len(text));

// Test Lexical Scoping (already existed but verified)
print("--- Lexical Scoping ---");
let a = "global";
{
    let a = "local";
    print(a); // local
}
print(a); // global
